    \uD29C\uD1A0\uB9AC\uC5BC \uC124\uBA85\uC785\uB2C8\uB2E4. \uC790\uAC04\uC744 \uD655\uC778\uD558\uAE30
    \uC704\uD574 \uC774\uB807\uAC8C \uAE00\uC744 \uAE38\uAC8C \uC4F0\uACE0 \uC788\uB294\uB370\uC694,
    \uD560 \uB9D0\uC774 \uC5C6\uC5B4\uC11C \uBB38\uC81C\uC785\uB2C8\uB2E4. \uC774
    \uD3F0\uD2B8\uAC00 \uC544\uC8FC \uB9C8\uC74C\uC5D0 \uB4DC\uB294\uAD70\uC694.
    \uD2F0\uBA38\uB2C8\uC5D0\uC11C \uB098\uC628 \uD3F0\uD2B8\uC778\uB370 \uC544\uC8FC
    \uC77C\uC744 \uC798 \uD558\uB294\uAD70\uC694. "
