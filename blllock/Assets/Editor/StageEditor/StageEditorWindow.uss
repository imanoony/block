.root {
    flex-direction: column;
}

.toolbar {
    flex-direction: row;
}

.dimension-field {
    width: 160px;
    height: 50px;
}

.dimension-field .unity-base-field__input {
    height: 20px;
}

.main {
    flex-direction: row;
    flex-grow: 1;
}

.left-tab {
    background-color: rgb(45, 45, 45);
    width: 200px;
    flex-direction: column;
    flex-shrink: 0;
    flex-grow: 0;
}

.block {

}

.block-scroll {

}

.block-main {
    flex-direction: row;
    flex-wrap: wrap;
}

.block-item {
}

.block-item.selected {
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;

    border-top-color: red;
    border-bottom-color: red;
    border-left-color: red;
    border-right-color: red;
}


.tag {
    background-color: rgb(50, 50, 50);
    height: 50px;
    flex-direction: row;
    flex-shrink: 0;
    flex-grow: 0;
}

.canvas {
    flex-grow: 1;
}

.canvas-scroll {

}

.canvas-main {
    background-color: rgb(25, 25, 25);
}

.canvas-content {
    transform-origin: top left;
}

.canvas-content .layer {
    position: absolute;

    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

.right-tab {
    background-color: rgb(45, 45, 45);
    width: 200px;
    flex-direction: row;
    flex-shrink: 0;
    flex-grow: 0;
}

.brush {
    background-color: rgb(50, 50, 50);
    width: 100px;
}

.brush-scroll {

}

.brush-main {
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.brush-item {
    width: 40px;
    height: 40px;
}

.brush-item.selected {
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;

    border-top-color: red;
    border-bottom-color: red;
    border-left-color: red;
    border-right-color: red;
}

.palette {
    width: 100px;
}

.palette-scroll {

}

.palette-main {
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.palette-item {
    width: 40px;
    height: 40px;
    justify-content: center;
    align-items: center;
}

.palette-item.selected {
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;

    border-top-color: red;
    border-bottom-color: red;
    border-left-color: red;
    border-right-color: red;
}

.palette-item.background-tile {
    background-color: gray;
}

.palette-item.circuit-tile {
    background-color: white;
}

.palette-item .node {
    width: 20px;
    height: 20px;
}

.palette-item .node.output {
    background-color: rgb(184, 184, 184);

    border-top-color: rgb(184, 184, 184);
    border-right-color: rgb(184, 184, 184);
    border-bottom-color: rgb(184, 184, 184);
    border-left-color: rgb(184, 184, 184);
}

.palette-item .node.input {
    background-color: rgb(84, 220, 227);

    border-top-color: rgb(84, 220, 227);
    border-right-color: rgb(84, 220, 227);
    border-bottom-color: rgb(84, 220, 227);
    border-left-color: rgb(84, 220, 227);
}

.palette-item .node.both {

}

.palette-item .node.out {
    background-color: transparent;

    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

.palette-item .node.x {
    rotate: 45deg;
}

.palette-item .node.y {
    
}

.palette-item .node.z {
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
}

.palette-item .vbarrier {
    width: 10px;
    height: 40px;
    background-color: rgb(128,64,0);
}

.palette-item .hbarrier {
    width: 40px;
    height: 10px;
    background-color: rgb(128,64,0);
}

.painted {
    width: 50px;
    height: 50px;
}